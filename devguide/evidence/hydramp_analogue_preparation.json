  "proposed_contract": {
    "first_route": "Improvement by both native scores, deterministic softmax, no optional sequence filters/descriptors/discovery",
    "inputs": "Nonempty CPU int64[B,25], nonempty canonical post-padded prototype rows,0..20; preserve duplicate input occurrences; explicit uint32-compatible seed, positive attemptsA, finite nonnegative dimensionless temperatureT",
    "sampling": "Local MT19937 scaled normal in attempt-major rowa*B+i; std=exp(raw_log_variance/2); no PCA; preserve float64 noise/conditioned values until FP32 decoder",
    "native_score_policy": "strict newAMP>prototypeAMP AND newMIC>prototypeMIC; MIC denotes native low-MIC-class score, not measured MIC/hemolysis/biological improvement",
    "output": "Primary ordered per-prototype-occurrence records plus all-attempt trace and native self-exclusion/lexical dedup/first accepted attempt mapping; no silently collapsing sequence-keyed dict",
    "generated_empty_tokens": "Retain raw zeros/empty projection/native decisions and explicit diagnostics; no repair or inference of qualified molecular proposal",
    "call_topology_future_only": {
      "encoder_B": 1,
      "encoder_BxA": 1,
      "prototype_heads": 2,
      "decoder": 1,
      "generated_heads": 2,
      "neural_evaluations_per_analogue_call": 7,
      "currently_authorized_analogue_calls": 0
    },
    "A1_synthetic_criterion_proposed": {
      "atol": 2e-06,
      "rtol": 2e-05,
      "exact_policy_mapping_assertions": true,
      "pretrained_acceptance_criterion": false
    },
    "MolSysMT_boundary": "General molecular/file transport stays with MolSysMT; HydrAMP owns only its native model-token representation, operations and method policy"
  },
